# Copia este archivo como .env y llena los valores

DATABASE_URL="file:./dev.db"
AUTH_SECRET="cambia-esta-clave"

# ============================================================
# CONFIGURACIÓN DE IA - PROVEEDOR 1 (Principal: GLM Coding Plan)
# Endpoint alterno internacional: https://api.z.ai/api/coding/paas/v4
# ============================================================
AI_BASE_URL="https://open.bigmodel.cn/api/coding/paas/v4"
AI_API_KEY=""
AI_MODEL="glm-4.5"

# ============================================================
# CONFIGURACIÓN DE IA - PROVEEDOR 2 (Secundario / Respaldo)
# Si el proveedor 1 se queda sin cuota o falla, el sistema intentará
# automáticamente con esta segunda API key.
# Compatible con: OpenRouter, OpenAI, DeepSeek, Groq u otra key de GLM.
# ============================================================
AI_BASE_URL_2="https://api.z.ai/api/coding/paas/v4"
AI_API_KEY_2=""
AI_MODEL_2="GLM-5.3"
